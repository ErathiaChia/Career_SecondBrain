<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.era.weekday-sync</string>
  <!-- Optional (install.sh --with-weekday-sync): Mon-Fri 02:00 light sync,
       convert + embed only, no LLM, so new documents are searchable the same week. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>cd __ERA_REPO__/era_indexer && __ERA_PYTHON__ -m career_history.cli sync --once --mode documents --limit 200</string>
  </array>
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>2</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>2</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>2</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>2</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>2</integer><key>Minute</key><integer>0</integer></dict>
  </array>
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/era/launchd-weekday-sync.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/era/launchd-weekday-sync.log</string>
  <key>RunAtLoad</key><false/>
</dict>
</plist>
