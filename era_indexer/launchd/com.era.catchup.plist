<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.era.catchup</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__ERA_REPO__/era_indexer/scripts/weekly.sh</string>
    <string>--catchup</string>
  </array>
  <!-- Sun-Thu 23:00: exits immediately unless the last run was partial/failed
       and there is extraction backlog; stops by 06:00. -->
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Weekday</key><integer>0</integer><key>Hour</key><integer>23</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>23</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>23</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>23</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>23</integer><key>Minute</key><integer>0</integer></dict>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>ERA_REPO</key><string>__ERA_REPO__</string>
    <key>ERA_PYTHON</key><string>__ERA_PYTHON__</string>
    <key>ERA_DEADLINE</key><string>06:00</string>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/era/launchd-catchup.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/era/launchd-catchup.log</string>
  <key>RunAtLoad</key><false/>
  <key>Nice</key><integer>5</integer>
</dict>
</plist>
