<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.era.reranker</string>
  <!-- Infinity cross-encoder reranker (bge-reranker-v2-m3) on :7997, always up. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__ERA_REPO__/era_mcp/tools/run_reranker.sh</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string></dict>
  <key>KeepAlive</key><true/>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/era/launchd-reranker.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/era/launchd-reranker.log</string>
</dict>
</plist>
