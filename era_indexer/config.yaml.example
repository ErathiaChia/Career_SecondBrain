# Era Vault indexer configuration.
# Copy to config.yaml and edit for your environment.

database:
  # Postgres on the Synology. Must have pgvector extension available.
  connection_string: "postgresql://era:CHANGEME@synology.local:15432/era_vault"

paths:
  # Roots of your knowledge base on the network mount.
  # Add as many directories as you need; each is walked recursively.
  source_directories:
    - "/Volumes/Synology/Vault"
    # - "/Volumes/Synology/AnotherVault"
  # Subtrees (relative to each root; prefix or glob) never ingested — keeps the
  # pipeline's own outputs (weekly reports) out of the index.
  ignore_subtrees:
    - "Z. AI_Notebook/Weekly"

# Who "me" is (the vault owner). Facts whose owner is one of these names, or a
# first-person reference, are attributed to one canonical person entity; roles,
# achievements and skills are derived from it. See career_history/identity.py.
me:
  name: ""                       # e.g. "Jane Tan"
  aliases: []                    # e.g. ["Jane", "JT", "jtan"]
  default_roles: [project_manager, solution_architect]   # prior for role inference
  role_prior_weight: 0.35
  ai_keywords: [ai, llm, genai, agent, rag, "machine learning", chatbot, copilot]

extraction:
  # Folders (top-level, as stored in file_registry.folder) extracted before the
  # rest of the backlog; within a folder most-recently-modified files go first.
  priority_folders: []
  # Weekly cap (also --max-docs). ~85 s/file -> 1200 ≈ 28 h.
  max_docs_per_run: 1200

reports:
  # Where the weekly CAREER INTELLIGENCE report is written (ERA_REPORT_DIR overrides).
  weekly_dir: "~/Library/Application Support/era/reports"
  # Also copy it into the vault (excluded from ingestion via paths.ignore_subtrees).
  publish_to_vault: false
  vault_subdir: "Z. AI_Notebook/Weekly"

eval:
  # Write a probe file into the vault before each run so the scorecard can
  # verify new documents reach the index.
  freshness_probe_enabled: false
  # The weekly eval stage runs era_mcp's scorecard against this server with the
  # question sets under local/eval (git-ignored) and stores runs in runs_dir.
  base_url: "http://localhost:8808"
  # sets_dir: "<repo>/local/eval"
  # runs_dir: "<repo>/local/eval/runs"

models:
  # ---- Ollama embedding ----
  # Must be pulled first on the indexer AND MCP hosts:
  #   `ollama pull qwen3-embedding:0.6b`
  # Qwen3-Embedding-0.6B is multilingual (EN+ZH), 1024-dim, and has a 32k
  # context window. If you change to a different dimension, update vector(N) dim
  # in schema.sql, add a migration, and re-embed.
  embedding_model: "qwen3-embedding:0.6b"
  embedding_dim: 1024
  # Graph extraction + contextual-blurb LLM. Runs on the Mac (the NAS Ollama is
  # too small). A 9B MLX model is fast on Metal and reliable at JSON; avoid 35B
  # for per-chunk extraction (~15-40s/chunk).
  graph_extraction_model: "qwen3.5:9b-mlx"
  # qwen3.5 works for JSON extraction with graph_extraction_think=false (validated
  # over ~1,700 files at ~85 s/file); gemma*/llama* also work. Read timeout per
  # extraction call (seconds); document-level calls on a local model can take minutes.
  graph_extraction_timeout: 600
  # Document-level extraction splits long files into windows of this many chars
  # (one call each, merged) instead of truncating to the first window.
  graph_doc_window_chars: 12000
  graph_doc_max_windows: 6
  # Thinking must stay off for JSON extraction (thinking models run to the timeout).
  graph_extraction_think: false
  graph_num_ctx: 16384
  # Output budget per window: facts + entities + relationships + the document
  # card (Phase 2). A truncated reply (done_reason=length) is retried as halves.
  graph_num_predict: 6144
  graph_keep_alive: "30m"
  # Optional: separate model for the Contextual-Retrieval situating blurb.
  # Defaults to graph_extraction_model when unset.
  # contextual_blurb_model: "qwen3.5:9b-mlx"

  # ---- MLX Whisper (Apple Silicon, transcription only — no diarization) ----
  # Runs on the Mac GPU via Metal. whisper_model is used only to derive the MLX
  # repo when whisper_mlx_repo is unset.
  whisper_model: "large-v3"          # or "medium", "small" for faster/lower-quality
  whisper_mlx_repo: "mlx-community/whisper-large-v3-mlx"
  whisper_language: null             # null = auto-detect per file
  allowed_languages: ["en", "zh"]    # set to null to allow all detected languages
  # Anti-hallucination decode options (see mlx_whisper.transcribe):
  whisper_condition_on_previous_text: false   # stop repetition/failure loops
  whisper_compression_ratio_threshold: 1.8    # re-roll repetitive segments (default 2.4)
  # Optional extra decode knobs (forwarded only when set):
  # whisper_no_speech_threshold: 0.6
  # whisper_logprob_threshold: -1.0
  # whisper_initial_prompt: null

processing:
  chunk_size: 1000          # flat-document + audio chunking
  chunk_overlap: 200
  max_retries: 3
  # Parent-child ("small-to-big"): children are embedded; parents returned as
  # context. Sizes are in characters (~4 chars/token). The balanced Qwen3
  # profile reduces chunk count while preserving focused child matches.
  parent_chunk_size: 10000
  parent_chunk_overlap: 400
  child_chunk_size: 2000
  child_chunk_overlap: 200

document_images:
  descriptions_enabled: false
  formats: [".pdf", ".docx", ".pptx", ".xlsx"]
  # Local Ollama OpenAI-compatible endpoint. Requires a vision model pulled first.
  api_url: "http://localhost:11434/v1/chat/completions"
  model: "qwen3-vl:8b"
  max_completion_tokens: 2000
  timeout_seconds: 180
  concurrency: 3
  # OCR runs on every page; on digital documents it dominates runtime and the
  # vision captioner already covers text in images. Enable only for scans.
  ocr_enabled: false
  images_scale: 2.0
  generate_picture_images: true
  prompt: |
    Describe this image for a personal knowledge-base search index.
    Be detailed and factual. Capture visible text, diagrams, charts, tables,
    UI screenshots, workflows, entities, labels, and relationships.
    If the image is decorative or contains no useful information, say so briefly.

# V2 rollout flags. Keep disabled until each phase is validated on a small folder.
v2:
  structure_aware_chunking_enabled: true
  contextual_embeddings_enabled: true
  parent_child_retrieval_enabled: true
  # Anthropic-style Contextual Retrieval: an LLM writes a 1-2 sentence blurb per
  # chunk situating it in its document, folded into the embedded + keyword text.
  # Requires contextual_embeddings_enabled. Costs one LLM call per chunk and
  # requires a re-embed (new embedding_content_version). Enable for the pilot.
  contextual_llm_blurb_enabled: false
  hybrid_search_enabled: false
  reranker_enabled: false
  # Knowledge graph (entities + relationships + facts). The graph-refresh /
  # v3-refresh CLI commands extract directly on a single --folder REGARDLESS of
  # these flags; the flags only gate (a) auto-refresh during update/sync (all
  # three must be true) and (b) whether retrieval uses the graph. The same
  # extraction pass also writes decisions/commitments/events to knowledge_facts
  # (Layer 1). Extraction is additive over already-indexed chunks: no re-embed.
  entity_extraction_enabled: false
  relationship_extraction_enabled: false
  graph_retrieval_enabled: false

  # Continuous sync wraps the existing discover + run flow.
  sync_interval_seconds: 300

  # Optional override for graph extraction; defaults to local Ollama.
  graph_ollama_base_url: "http://localhost:11434"

  # When contextual_embeddings_enabled is true, each chunk is embedded (and
  # keyword-indexed) with a compact, labeled context header built in code from
  # filename-derived fields (client, product, doc type, version, IDs), folder,
  # document title, section path, and chunk type. See structure._context_header.

v3:
  knowledge_os_enabled: false
  summaries_enabled: false
  communities_enabled: false
  graph_metadata_enabled: false
  knowledge_retrieval_enabled: false
  graph_export_enabled: true

  summary_model: "extractive-local"
  summary_prompt_version: "v3-summary-v1"
  community_algorithm: "relationship-neighborhood"
  community_algorithm_version: "v3-community-v1"

# Deterministic project-entity seeding (Layer 1; no LLM). The folder segment
# immediately AFTER each fragment below is treated as a project; aliases are
# derived by stripping the numeric prefix ("01_CL89" -> "CL89"). Runs inside
# discover and via the `seed-entities` command. Leave empty to disable. Use the
# path fragments as they appear in file_registry.file_path; add each active
# period's container.
seed:
  project_roots: []
  # Example:
  #   project_roots:
  #     - "/01 Project/2026/"
  #     - "/01 Project/2025/"

extensions:
  audio:     [".mp3", ".wav", ".m4a", ".flac", ".ogg", ".mp4", ".mov"]
  # .srt/.vtt: caption transcripts saved next to recordings; .eml: saved emails.
  documents: [".pdf", ".docx", ".pptx", ".xlsx", ".md", ".txt", ".srt", ".vtt", ".eml"]

huggingface:
  # Used only for first-time model downloads from Hugging Face (the MLX Whisper
  # repo). mlx-community repos are public, so a token is usually unnecessary;
  # set one only if a gated repo requires it. After `career_history.cli bootstrap`
  # caches models locally you can run fully offline. Prefer the HF_TOKEN env var.
  token: ""
