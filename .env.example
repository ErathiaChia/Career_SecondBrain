# Copy this file to .env and fill in the private values locally. .env is
# git-ignored. ERA_VAULT_DB_* is read by era_indexer, era_mcp and era_auditor.
#
# Organisation policy: vault content stays on the local network. Cloud LLMs are
# OFF (see CLOUD_LLM_OPTIN below). Never put real client names in this file.

# --- Hosts (Tailscale MagicDNS names or LAN IPs; no literal IPs in git) ---
NAS_HOST="nas.your-tailnet.ts.net"        # Postgres + embeddings Ollama + era_mcp
MAC_HOST="mac.your-tailnet.ts.net"        # heavy LLM (Ollama/MLX) + Infinity reranker
MAC_LAN_HOST="mac.local"                  # optional LAN fallback for the Mac

# --- Synology PostgreSQL ---
ERA_VAULT_DB_HOST="${NAS_HOST}"
ERA_VAULT_DB_PORT="15432"
ERA_VAULT_DB_NAME="era_vault"
ERA_VAULT_DB_USER="era"
ERA_VAULT_DB_PASSWORD="your_database_password_here"

# Hugging Face token used for one-time model bootstrap.
HF_TOKEN="hf_your_token_here"

# --- Models (query side; the indexer's models live in era_indexer/config.yaml) ---
LLM_PRIMARY_MODEL="qwen3.5:35b"           # rewrite + Judge + synthesis on the Mac
# LLM_JUDGE_MODEL=                        # defaults to LLM_PRIMARY_MODEL
EMBEDDING_MODEL="qwen3-embedding:0.6b"    # must match the indexer + vector(1024)
RERANK_KIND="infinity"                    # infinity (Mac :7997) | llm_score | none

# --- Access ---
# Bearer token required on every era_mcp endpoint (OpenAPI + /mcp). Generate:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_BEARER_TOKEN=""

# --- Cloud LLMs: OFF by policy. Opt-in only, never for vault content. ---
CLOUD_LLM_OPTIN="0"
LLM_FALLBACK_ENABLED="0"
AUDITOR_CLOUD_OPTIN="0"
# OPENAI_API_KEY=                         # unused unless the opt-ins above are 1
# Auditor LLM (local Ollama, OpenAI-compatible endpoint):
AUDITOR_LLM_BASE_URL="http://localhost:11434/v1"
AUDITOR_LLM_MODEL="qwen3.5:9b-mlx"
# Private registries (client names) live outside git:
# AUDITOR_REGISTRY_DIR="<workspace>/local/auditor/rules"

# --- era_mcp retrieval relevance (optional; defaults shown) ---
QUERY_INSTRUCTION_ENABLED="1"
FILENAME_SEARCH_ENABLED="1"
LEXICAL_PATH_WEIGHT="0.5"
MULTI_QUERY_ENABLED="1"
ADAPTIVE_TOPK_ENABLED="1"
TOPK_SIMPLE="8"
TOPK_MODERATE="20"
TOPK_COMPLEX="40"
DOC_FIRST_ASSEMBLY_ENABLED="1"
DOC_FIRST_MAX_DOCS="8"
DOC_FIRST_MAX_PARENTS_PER_DOC="3"
RERANK_MAX_CANDIDATES="40"

# --- Bounded agent (/ask) ---
AGENT_MAX_ITERS="3"
AGENT_MAX_TOOL_CALLS_PER_ITERATION="3"
AGENT_MAX_DOCUMENTS="10"
AGENT_MAX_CONTEXT_TOKENS="20000"
AGENT_TIME_BUDGET="120"
STRONG_RERANK_THRESHOLD="0.8"

# --- Weekly pipeline (Mac) ---
ERA_MAX_DOCS="1200"
ERA_DEADLINE="Mon 05:00"
# ERA_REPORT_DIR="~/Library/Application Support/era/reports"
